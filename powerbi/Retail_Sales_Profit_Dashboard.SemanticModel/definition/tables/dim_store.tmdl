table dim_store

	column store_id
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: store_id

	column store_name
		dataType: string
		summarizeBy: none
		sourceColumn: store_name

	column city
		dataType: string
		dataCategory: City
		summarizeBy: none
		sourceColumn: city

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column province
		dataType: string
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: province

	column store_format
		dataType: string
		summarizeBy: none
		sourceColumn: store_format

	column square_feet
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: square_feet

	column open_year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: open_year

	column latitude
		dataType: double
		dataCategory: Latitude
		summarizeBy: none
		sourceColumn: latitude

	column longitude
		dataType: double
		dataCategory: Longitude
		summarizeBy: none
		sourceColumn: longitude

	partition dim_store = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "dim_store.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"store_id", Int64.Type}, {"store_name", type text}, {"city", type text}, {"region", type text}, {"province", type text}, {"store_format", type text}, {"square_feet", Int64.Type}, {"open_year", Int64.Type}, {"latitude", type number}, {"longitude", type number}}, "en-US")
			in
			    #"Changed Type"

