table fact_store_day

	column date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column store_id
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: store_id

	column customer_transactions
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: sum
		sourceColumn: customer_transactions

	column labour_hours
		dataType: double
		isHidden
		summarizeBy: sum
		sourceColumn: labour_hours

	partition fact_store_day = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "fact_store_day.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"date", type date}, {"store_id", Int64.Type}, {"customer_transactions", Int64.Type}, {"labour_hours", type number}}, "en-US")
			in
			    #"Changed Type"

