table _Measures

	measure 'Net Sales' = SUM ( fact_sales[net_sales] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "1 Sales"

	measure 'Gross Sales' = SUM ( fact_sales[gross_sales] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "1 Sales"

	measure Markdowns = SUM ( fact_sales[markdown_amount] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "1 Sales"

	measure COGS = SUM ( fact_sales[cogs] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "1 Sales"

	measure 'Gross Profit' = SUM ( fact_sales[gross_profit] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "1 Sales"

	measure 'Units Sold' = SUM ( fact_sales[units_sold] )
		formatString: #,0
		displayFolder: "1 Sales"

	measure Returns = SUM ( fact_sales[return_amount] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "1 Sales"

	measure 'Gross Margin %' = DIVIDE ( [Gross Profit], [Net Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: "2 Ratios"

	measure 'Markdown Rate %' = DIVIDE ( [Markdowns], [Gross Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: "2 Ratios"

	measure 'Return Rate %' = DIVIDE ( [Returns], [Net Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: "2 Ratios"

	measure 'Department Share %' = ```
			DIVIDE (
			    [Net Sales],
			    CALCULATE ( [Net Sales], ALLSELECTED ( dim_department ) )
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: "2 Ratios"

	measure 'Net Sales PY' = CALCULATE ( [Net Sales], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "3 Time Intelligence"

	measure 'Net Sales YoY' = IF ( NOT ISBLANK ( [Net Sales PY] ), [Net Sales] - [Net Sales PY] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "3 Time Intelligence"

	measure 'Net Sales YoY %' = DIVIDE ( [Net Sales] - [Net Sales PY], [Net Sales PY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: "3 Time Intelligence"

	measure 'Gross Profit PY' = CALCULATE ( [Gross Profit], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "3 Time Intelligence"

	measure 'Gross Profit YoY %' = DIVIDE ( [Gross Profit] - [Gross Profit PY], [Gross Profit PY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: "3 Time Intelligence"

	measure 'Gross Margin % PY' = CALCULATE ( [Gross Margin %], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: "3 Time Intelligence"

	measure 'Gross Margin Change (pts)' = ```
			VAR CurrentMargin = [Gross Margin %]
			VAR PriorMargin = [Gross Margin % PY]
			RETURN
			    IF ( NOT ISBLANK ( PriorMargin ), ( CurrentMargin - PriorMargin ) * 100 )
			```
		formatString: "+0.00"" pts"";-0.00"" pts"";0.00"" pts"""
		displayFolder: "3 Time Intelligence"

	measure 'Markdown Rate % PY' = CALCULATE ( [Markdown Rate %], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: "3 Time Intelligence"

	measure 'Net Sales YTD' = TOTALYTD ( [Net Sales], dim_date[date] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "3 Time Intelligence"

	measure 'Net Sales PY YTD' = CALCULATE ( [Net Sales YTD], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "3 Time Intelligence"

	measure 'Net Sales PM' = CALCULATE ( [Net Sales], DATEADD ( dim_date[date], -1, MONTH ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "3 Time Intelligence"

	measure 'Net Sales MoM %' = DIVIDE ( [Net Sales] - [Net Sales PM], [Net Sales PM] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: "3 Time Intelligence"

	measure 'Net Sales (All Depts & Channels)' = ```
			CALCULATE (
			    [Net Sales],
			    REMOVEFILTERS ( dim_department ),
			    REMOVEFILTERS ( dim_channel )
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "4 Targets"

	measure 'Sales Target' = SUM ( fact_targets[sales_target] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "4 Targets"

	measure 'Variance to Target' = ```
			IF (
			    NOT ISBLANK ( [Sales Target] ),
			    [Net Sales (All Depts & Channels)] - [Sales Target]
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "4 Targets"

	measure 'Target Attainment %' = DIVIDE ( [Net Sales (All Depts & Channels)], [Sales Target] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: "4 Targets"

	measure 'Gauge Max' = [Sales Target] * 1.2
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "4 Targets"

	measure 'Customer Transactions' = SUM ( fact_store_day[customer_transactions] )
		formatString: #,0
		displayFolder: "5 Store Operations"

	measure 'Labour Hours' = SUM ( fact_store_day[labour_hours] )
		formatString: #,0
		displayFolder: "5 Store Operations"

	measure 'Average Basket' = DIVIDE ( [Net Sales (All Depts & Channels)], [Customer Transactions] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: "5 Store Operations"

	measure 'Sales per Labour Hour' = DIVIDE ( [Net Sales (All Depts & Channels)], [Labour Hours] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: "5 Store Operations"

	measure 'Store Rank by Net Sales' = ```
			IF (
			    HASONEVALUE ( dim_store[store_name] ),
			    RANKX ( ALLSELECTED ( dim_store ), [Net Sales], , DESC, DENSE )
			)
			```
		formatString: 0
		displayFolder: "5 Store Operations"

	measure 'Online Sales' = ```
			CALCULATE (
			    [Net Sales],
			    REMOVEFILTERS ( dim_channel ),
			    dim_channel[channel_group] = "Online"
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "6 Channels"

	measure 'Online Share %' = DIVIDE ( [Online Sales], CALCULATE ( [Net Sales], REMOVEFILTERS ( dim_channel ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: "6 Channels"

	measure 'Online Sales PY' = CALCULATE ( [Online Sales], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: "6 Channels"

	measure 'Online Sales YoY %' = DIVIDE ( [Online Sales] - [Online Sales PY], [Online Sales PY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: "6 Channels"

	measure 'Desk Contacts' = SUM ( fact_service_desk[contacts] )
		formatString: #,0
		displayFolder: "7 Service Desk"

	measure 'Resolved First Contact' = SUM ( fact_service_desk[resolved_first_contact] )
		formatString: #,0
		displayFolder: "7 Service Desk"

	measure 'First Contact Resolution %' = DIVIDE ( [Resolved First Contact], [Desk Contacts] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: "7 Service Desk"

	measure 'Avg Handle Time (min)' = DIVIDE ( SUM ( fact_service_desk[total_handle_minutes] ), [Desk Contacts] )
		formatString: 0.00
		displayFolder: "7 Service Desk"

	measure 'Contacts per 1K Transactions' = DIVIDE ( [Desk Contacts], [Customer Transactions] ) * 1000
		formatString: 0.0
		displayFolder: "7 Service Desk"

	measure 'Desk Contacts PY' = CALCULATE ( [Desk Contacts], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: #,0
		displayFolder: "7 Service Desk"

	measure 'Desk Contacts YoY %' = DIVIDE ( [Desk Contacts] - [Desk Contacts PY], [Desk Contacts PY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: "7 Service Desk"

	measure 'Online Order Contacts' = CALCULATE ( [Desk Contacts], fact_service_desk[contact_reason] = "Online order & delivery" )
		formatString: #,0
		displayFolder: "7 Service Desk"

	measure 'Net Sales vs LY Label' = ```
			VAR Change = [Net Sales YoY %]
			RETURN
			    IF (
			        ISBLANK ( Change ),
			        "No prior year in data",
			        IF ( Change >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Change ), "0.0%" ) & " vs last year"
			    )
			```
		displayFolder: "8 Labels & Formatting"

	measure 'Gross Profit vs LY Label' = ```
			VAR Change = [Gross Profit YoY %]
			RETURN
			    IF (
			        ISBLANK ( Change ),
			        "No prior year in data",
			        IF ( Change >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Change ), "0.0%" ) & " vs last year"
			    )
			```
		displayFolder: "8 Labels & Formatting"

	measure 'Margin vs LY Label' = ```
			VAR Change = [Gross Margin Change (pts)]
			RETURN
			    IF (
			        ISBLANK ( Change ),
			        "No prior year in data",
			        IF ( Change >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Change ), "0.00" ) & " pts vs last year"
			    )
			```
		displayFolder: "8 Labels & Formatting"

	measure 'Target vs Plan Label' = ```
			VAR Gap = [Variance to Target]
			RETURN
			    IF (
			        ISBLANK ( Gap ),
			        BLANK (),
			        IF ( Gap >= 0, "▲ ", "▼ " )
			            & FORMAT ( ABS ( Gap ) / 1000000, "$#,0.0" ) & "M"
			            & IF ( Gap >= 0, " above plan", " below plan" )
			    )
			```
		displayFolder: "8 Labels & Formatting"

	measure 'Selected Period' = ```
			VAR FirstYear = MIN ( dim_date[year] )
			VAR LastYear = MAX ( dim_date[year] )
			RETURN
			    IF ( FirstYear = LastYear, "Year " & FirstYear, FirstYear & " to " & LastYear )
			```
		displayFolder: "8 Labels & Formatting"

	measure 'YoY Colour' = ```
			SWITCH (
			    TRUE (),
			    ISBLANK ( [Net Sales YoY %] ), "#898781",
			    [Net Sales YoY %] >= 0, "#006300",
			    "#D03B3B"
			)
			```
		displayFolder: "8 Labels & Formatting"

	measure 'Attainment Colour' = ```
			SWITCH (
			    TRUE (),
			    ISBLANK ( [Target Attainment %] ), "#898781",
			    [Target Attainment %] >= 1, "#006300",
			    "#D03B3B"
			)
			```
		displayFolder: "8 Labels & Formatting"

	column Value
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Value

	partition _Measures = m
		mode: import
		source =
			let
			    Source = #table(type table [Value = text], {})
			in
			    Source

