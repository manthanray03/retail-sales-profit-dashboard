table dim_channel

	column channel_id
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: channel_id

	column channel_name
		dataType: string
		summarizeBy: none
		sourceColumn: channel_name

	column channel_group
		dataType: string
		summarizeBy: none
		sourceColumn: channel_group

	partition dim_channel = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "dim_channel.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"channel_id", Int64.Type}, {"channel_name", type text}, {"channel_group", type text}}, "en-US")
			in
			    #"Changed Type"

