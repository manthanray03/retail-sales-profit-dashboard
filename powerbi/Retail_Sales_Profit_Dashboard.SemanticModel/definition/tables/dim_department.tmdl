table dim_department

	column department_id
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: department_id

	column department_name
		dataType: string
		summarizeBy: none
		sourceColumn: department_name

	column department_group
		dataType: string
		summarizeBy: none
		sourceColumn: department_group

	partition dim_department = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "dim_department.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"department_id", Int64.Type}, {"department_name", type text}, {"department_group", type text}}, "en-US")
			in
			    #"Changed Type"

