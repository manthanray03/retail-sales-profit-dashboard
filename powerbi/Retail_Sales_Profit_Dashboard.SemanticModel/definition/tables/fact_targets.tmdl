table fact_targets
	lineageTag: 8b9e81f3-2200-4feb-98ce-79b222f25fe8

	column month_start
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 61727c13-0330-41ba-bce1-66a1e75ee363
		summarizeBy: none
		sourceColumn: month_start

		annotation UnderlyingDateTimeDataType = Date

	column store_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 96e71a45-6baf-4b24-aafa-f91ead2edaf0
		summarizeBy: none
		sourceColumn: store_id

	column sales_target
		dataType: decimal
		isHidden
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 62ece8e8-aa07-4c54-8792-23354ecbe5ed
		summarizeBy: sum
		sourceColumn: sales_target

	partition fact_targets = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_targets.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"month_start", type date}, {"store_id", Int64.Type}, {"sales_target", Currency.Type}}, "en-US")
				in
				    #"Changed Type"

