table fact_targets

	column month_start
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: month_start

		annotation UnderlyingDateTimeDataType = Date

	column store_id
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: store_id

	column sales_target
		dataType: decimal
		isHidden
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		summarizeBy: sum
		sourceColumn: sales_target

	partition fact_targets = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "fact_targets.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"month_start", type date}, {"store_id", Int64.Type}, {"sales_target", Currency.Type}}, "en-US")
			in
			    #"Changed Type"

