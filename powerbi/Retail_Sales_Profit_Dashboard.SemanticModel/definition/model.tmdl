model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "dim_date", "dim_store", "dim_department", "dim_channel", "fact_sales", "fact_store_day", "fact_service_desk", "fact_targets", "_Measures"]

ref table dim_date
ref table dim_store
ref table dim_department
ref table dim_channel
ref table fact_sales
ref table fact_store_day
ref table fact_service_desk
ref table fact_targets
ref table _Measures
